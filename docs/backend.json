
{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled service for a client.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Reference to the client user ID" },
        "clientName": { "type": "string" },
        "serviceName": { "type": "string" },
        "barberName": { "type": "string" },
        "date": { "type": "string", "description": "ISO format date YYYY-MM-DD" },
        "time": { "type": "string", "description": "Time in HH:mm format" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "ongoing", "cancelled", "completed"] },
        "clientImage": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["clientName", "serviceName", "barberName", "date", "time", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notifications for users or admins.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "type": { "type": "string", "enum": ["info", "success", "alert"] },
        "recipientId": { "type": "string", "description": "User ID of the recipient" },
        "recipientRole": { "type": "string", "enum": ["admin", "client"] }
      },
      "required": ["title", "message", "createdAt", "read", "recipientRole"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "loyaltyPoints": { "type": "number", "description": "Current points in the loyalty cycle" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of client appointments."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Collection of system notifications."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profile data."
    }
  }
}
