{
  "entities": {
    "Appointment": {
      "title": "Appointment",
      "description": "A scheduled service for a client.",
      "type": "object",
      "properties": {
        "userId": { "type": "string", "description": "Reference to the client user ID" },
        "clientName": { "type": "string" },
        "serviceName": { "type": "string" },
        "barberName": { "type": "string" },
        "date": { "type": "string", "description": "ISO format date YYYY-MM-DD" },
        "time": { "type": "string", "description": "Time in HH:mm format" },
        "status": { "type": "string", "enum": ["pending", "confirmed", "ongoing", "cancelled", "completed"] },
        "clientImage": { "type": "string" },
        "price": { "type": "number" }
      },
      "required": ["clientName", "serviceName", "barberName", "date", "time", "status"]
    },
    "Notification": {
      "title": "Notification",
      "description": "System notifications for users or admins.",
      "type": "object",
      "properties": {
        "title": { "type": "string" },
        "message": { "type": "string" },
        "createdAt": { "type": "string", "format": "date-time" },
        "read": { "type": "boolean" },
        "type": { "type": "string", "enum": ["info", "success", "alert"] },
        "recipientId": { "type": "string", "description": "User ID of the recipient" },
        "recipientRole": { "type": "string", "enum": ["admin", "client"] }
      },
      "required": ["title", "message", "createdAt", "read", "recipientRole"]
    },
    "User": {
      "title": "User",
      "description": "User profile information.",
      "type": "object",
      "properties": {
        "displayName": { "type": "string" },
        "email": { "type": "string", "format": "email" },
        "phone": { "type": "string" },
        "photoURL": { "type": "string" },
        "updatedAt": { "type": "string", "format": "date-time" },
        "loyaltyPoints": { "type": "number", "description": "Current points in the loyalty cycle" },
        "fcmToken": { "type": "string", "description": "Firebase Cloud Messaging token for push notifications" }
      }
    },
    "Barber": {
      "title": "Barber",
      "description": "A professional barber at the shop.",
      "type": "object",
      "properties": {
        "name": { "type": "string" },
        "specialty": { "type": "string" },
        "image": { "type": "string" },
        "status": { "type": "string", "enum": ["active", "inactive"] },
        "schedule": { "type": "string" },
        "break": { "type": "string" }
      },
      "required": ["name", "specialty", "status"]
    },
    "GlobalSettings": {
      "title": "Global Settings",
      "description": "Global shop configurations like service durations.",
      "type": "object",
      "properties": {
        "appointmentInterval": { "type": "number", "description": "Duration for hair cut in minutes" },
        "cleaningDuration": { "type": "number", "description": "Duration for beard in minutes" },
        "comboDuration": { "type": "number", "description": "Duration for combo in minutes" }
      }
    }
  },
  "auth": {
    "providers": ["google.com", "password"]
  },
  "firestore": {
    "/appointments/{appointmentId}": {
      "schema": "Appointment",
      "description": "Collection of client appointments."
    },
    "/notifications/{notificationId}": {
      "schema": "Notification",
      "description": "Collection of system notifications."
    },
    "/users/{userId}": {
      "schema": "User",
      "description": "Collection of user profile data."
    },
    "/barbers/{barberId}": {
      "schema": "Barber",
      "description": "Collection of shop barbers."
    },
    "/settings/{settingId}": {
      "schema": "GlobalSettings",
      "description": "Global configuration document."
    }
  }
}
